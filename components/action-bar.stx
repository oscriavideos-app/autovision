"use client"

import { useEffect, useRef, useState } from "react"
import { Mic, MicOff, ArrowUp, X } from "lucide-react"

export function ActionBar() {
  const [value, setValue] = useState("")
  const [listening, setListening] = useState(false)
  const [status, setStatus] = useState<'idle' | 'review'>('idle')
  const recognitionRef = useRef<any>(null)

  useEffect(() => {
    const SpeechRecognition = (window as any).SpeechRecognition || (window as any).webkitSpeechRecognition
    if (!SpeechRecognition) return

    const recognition = new SpeechRecognition()
    recognition.lang = "pt-BR"
    recognition.onresult = (event: any) => setValue(event.results[0][0].transcript)
    recognition.onend = () => setListening(false)
    recognitionRef.current = recognition
  }, [])

  const toggleListening = () => {
    if (listening) {
      recognitionRef.current?.stop()
      setStatus('review')
    } else {
      setValue("")
      setStatus('idle')
      recognitionRef.current?.start()
      setListening(true)
    }
  }

  return (
    <div className="flex flex-col gap-6">
      {status === 'review' && (
        <p className="text-2xl text-zinc-100 font-medium tracking-wide text-center py-4 bg-zinc-900/50 rounded-2xl border border-white/5">
          "{value || "Nenhuma descrição captada..."}"
        </p>
      )}

      {status === 'review' ? (
        <div className="flex gap-4">
          <button className="flex-1 h-20 rounded-2xl bg-sky-500 text-zinc-950 font-bold text-xl flex items-center justify-center gap-3 animate-neon-pulse shadow-2xl">
            <ArrowUp className="w-6 h-6" /> Enviar
          </button>
          <button onClick={() => setStatus('idle')} className="flex-1 h-20 rounded-2xl bg-orange-600 text-white font-bold text-xl flex items-center justify-center gap-3">
            <X className="w-6 h-6" /> Cancelar
          </button>
        </div>
      ) : (
        <button
          onClick={toggleListening}
          className={`h-20 w-full rounded-2xl text-2xl font-bold flex items-center justify-center gap-4 transition-all ${
            listening ? "bg-rose-500 animate-pulse text-white" : "bg-sky-500 animate-neon-pulse text-zinc-950"
          }`}
        >
          {listening ? <MicOff className="w-8 h-8" /> : <Mic className="w-8 h-8" />}
          {listening ? "Parar Gravação" : "Falar Modificação"}
        </button>
      )}
    </div>
  )
}